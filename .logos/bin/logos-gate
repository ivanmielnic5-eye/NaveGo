#!/usr/bin/env python3
"""Context Gate. Uso: logos-gate [PROYECTO] [--json]"""
import json, os, sys, subprocess, hashlib, datetime

REPO = os.getcwd()
MANIFEST = os.path.join(REPO, '.logos/MANIFEST.json')
VALIDATOR = os.path.join(REPO, '.logos/bin/validate-manifest')

def expand(p):
    if p.startswith('~'):
        return os.path.expanduser(p)
    if not os.path.isabs(p):
        return os.path.join(REPO, p)
    return p


def get_head(repo_path=None):
    """Devuelve el hash corto del commit HEAD actual, o None si falla.
    Si repo_path es None, usa REPO (comportamiento historico)."""
    target = repo_path or REPO
    try:
        r = subprocess.run(
            ['git', '-C', target, 'rev-parse', '--short', 'HEAD'],
            capture_output=True, text=True, check=True
        )
        return r.stdout.strip() or None
    except Exception:
        return None


def is_ancestor(older, newer, repo_path=None):
    """True si 'older' es ancestro de 'newer' (o iguales).
    Si repo_path es None, usa REPO (comportamiento historico)."""
    if older == newer:
        return True
    target = repo_path or REPO
    try:
        r = subprocess.run(
            ['git', '-C', target, 'merge-base', '--is-ancestor', older, newer],
            capture_output=True, text=True
        )
        return r.returncode == 0
    except Exception:
        return False


def _hash_file(path):
    """SHA256 de archivo (D-2026-0010)."""
    h = hashlib.sha256()
    try:
        with open(path, 'rb') as fh:
            while True:
                chunk = fh.read(65536)
                if not chunk:
                    break
                h.update(chunk)
    except (OSError, PermissionError):
        return None
    return h.hexdigest()


def _hash_dir_standard(dirpath):
    """SHA256 de directorio segun D-2026-0010."""
    dirpath = os.path.abspath(dirpath)
    entries = []
    for root, dirs, files in os.walk(dirpath):
        dirs[:] = [d for d in dirs if d != '.git']
        for fname in files:
            full = os.path.join(root, fname)
            rel = os.path.relpath(full, dirpath)
            entries.append((rel, full))
    entries.sort(key=lambda e: e[0].encode('utf-8'))
    h = hashlib.sha256()
    for rel, full in entries:
        if os.path.islink(full):
            target = os.readlink(full)
            h.update(rel.encode('utf-8'))
            h.update(b'\x00')
            h.update(b'LINK:' + target.encode('utf-8'))
            h.update(b'\x00')
            continue
        try:
            with open(full, 'rb') as fh:
                content = fh.read()
        except (OSError, PermissionError):
            continue
        h.update(rel.encode('utf-8'))
        h.update(b'\x00')
        h.update(str(len(content)).encode('utf-8'))
        h.update(b'\x00')
        h.update(content)
    return h.hexdigest()


def _hash_git_repo(repo_path):
    """SHA256 de archivos trackeados por git (working tree)."""
    repo_path = os.path.abspath(repo_path)
    r = subprocess.run(
        ['git', '-C', repo_path, 'ls-files', '-z'],
        capture_output=True
    )
    if r.returncode != 0:
        return None
    files = [fb for fb in r.stdout.split(b'\x00') if fb]
    files.sort()
    h = hashlib.sha256()
    for fbytes in files:
        rel = fbytes.decode('utf-8', errors='replace')
        full = os.path.join(repo_path, rel)
        if os.path.islink(full):
            target = os.readlink(full)
            h.update(rel.encode('utf-8'))
            h.update(b'\x00')
            h.update(b'LINK:' + target.encode('utf-8'))
            h.update(b'\x00')
            continue
        if not os.path.exists(full):
            h.update(rel.encode('utf-8'))
            h.update(b'\x00')
            h.update(b'DELETED\x00')
            continue
        try:
            with open(full, 'rb') as fh:
                content = fh.read()
        except (OSError, PermissionError):
            continue
        h.update(rel.encode('utf-8'))
        h.update(b'\x00')
        h.update(str(len(content)).encode('utf-8'))
        h.update(b'\x00')
        h.update(content)
    return h.hexdigest()


def compute_source_hash(path):
    """Devuelve el hash actual de una fuente segun su tipo.
    Devuelve None si el path no existe o no se puede hashear."""
    path = expand(path) if not os.path.isabs(os.path.expanduser(path)) else os.path.expanduser(path)
    if not os.path.exists(path):
        return None
    if os.path.isfile(path):
        return _hash_file(path)
    if os.path.isdir(path):
        if os.path.isdir(os.path.join(path, '.git')):
            return _hash_git_repo(path)
        return _hash_dir_standard(path)
    return None


def classify_review(reviewed, head, repo_path):
    """Clasifica reviewed_against_commit contra HEAD segun D-2026-0009.
    Devuelve (estado, detalle). Estados: CURRENT, STALE, DIVERGED,
    INVALID, UNREVIEWED."""
    if reviewed is None or reviewed == '' or str(reviewed).strip() == '':
        return ('UNREVIEWED', 'sin reviewed_against_commit')

    # Verificar existencia del commit
    r = subprocess.run(
        ['git', '-C', repo_path, 'cat-file', '-e', f'{reviewed}^{{commit}}'],
        capture_output=True, text=True
    )
    if r.returncode != 0:
        stderr = (r.stderr or '').lower()
        if any(s in stderr for s in ['not a valid object name',
                                      'unknown revision',
                                      'bad object',
                                      'does not exist',
                                      'invalid object name']):
            return ('INVALID', f'{reviewed} no existe como commit')
        return ('INVALID', f'error verificando {reviewed}: {(r.stderr or "").strip()[:80]}')

    if reviewed == head:
        return ('CURRENT', 'al dia')

    # Verificar ancestria
    r = subprocess.run(
        ['git', '-C', repo_path, 'merge-base', '--is-ancestor', reviewed, head],
        capture_output=True, text=True
    )
    if r.returncode == 0:
        return ('STALE', f'{reviewed} es ancestro de {head}')
    elif r.returncode == 1:
        return ('DIVERGED', f'{reviewed} no es ancestro de {head}')
    else:
        return ('DIVERGED', f'error merge-base: {(r.stderr or "").strip()[:80]}')


def policy_for(state, is_required):
    """Devuelve nivel de enforcement segun D-2026-0009.
    Niveles: OK, WARNING, BLOCKED."""
    if state == 'CURRENT':
        return 'OK'
    if state == 'STALE':
        return 'BLOCKED' if is_required else 'WARNING'
    if state == 'UNREVIEWED':
        return 'BLOCKED' if is_required else 'WARNING'
    if state == 'DIVERGED':
        return 'BLOCKED'
    if state == 'INVALID':
        return 'BLOCKED'
    return 'BLOCKED'  # conservador ante estado desconocido

args = [a for a in sys.argv[1:] if not a.startswith('--')]
flags = [a for a in sys.argv[1:] if a.startswith('--')]
JSON_OUT = '--json' in flags
PROYECTO_CLI = args[0] if args else None

# 0. Precondicion
if not os.path.exists(MANIFEST):
    result = {
        "status": "BLOCKED",
        "project": PROYECTO_CLI or "(desconocido)",
        "checks": {"manifest": "MISSING"},
        "reasons": ["manifest_missing"],
        "warnings": [],
        "evaluated_at": datetime.datetime.now().astimezone().isoformat(timespec='seconds')
    }
    if JSON_OUT:
        print(json.dumps(result, indent=2))
    else:
        print("=== LOGOS GATE ===")
        print(f"Manifest:         MISSING")
        print()
        print("STATUS: BLOCKED")
        print("  Razon: MANIFEST no existe.")
    sys.exit(2)

with open(MANIFEST) as f:
    m = json.load(f)

PROYECTO = PROYECTO_CLI or m.get('project', '?')
sources = {s['type']: s for s in m['sources']}

checks = {}
reasons = []
warnings = []

# 1. Validacion estructural
r = subprocess.run([VALIDATOR, MANIFEST], capture_output=True, text=True)
if r.returncode == 2:
    checks['manifest'] = 'BLOCKED'
    reasons.append('validator_blocked')
elif r.returncode == 1:
    checks['manifest'] = 'WARNING'
    warnings.append('validator_warning')
else:
    checks['manifest'] = 'OK'

# 1b. Chequeos estructurales reexpuestos
if checks['manifest'] == 'BLOCKED':
    checks['required'] = 'SKIP'
    checks['authority'] = 'SKIP'
else:
    tipos_req = m.get('required', [])
    tipos_aut = set()
    for s in m['sources']:
        if s.get('authority'):
            tipos_aut.add(s['type'])
    faltantes = [t for t in tipos_req if t not in tipos_aut]
    if faltantes:
        checks['required'] = f'BLOCKED (falta: {",".join(faltantes)})'
        reasons.append(f'missing_required:{",".join(faltantes)}')
    else:
        checks['required'] = 'OK'
    sing = {}
    for s in m['sources']:
        if s.get('authority') and s.get('role') == 'singleton':
            sing.setdefault(s['type'], []).append(s)
    dups = [t for t, l in sing.items() if len(l) > 1]
    if dups:
        checks['authority'] = f'BLOCKED (dup: {",".join(dups)})'
        reasons.append(f'duplicate_authority:{",".join(dups)}')
    else:
        checks['authority'] = 'OK'

# 2. Chequeos de coherencia
# CR-01: project_identity
if checks['manifest'] == 'BLOCKED':
    checks['project_identity'] = 'SKIP'
else:
    try:
        with open(expand(sources['state']['path'])) as f:
            state = json.load(f)
        with open(expand(sources['profile']['path'])) as f:
            profile = json.load(f)
        ctx_project = state.get('project', {}).get('id')
        prof_id = profile.get('id')
        if ctx_project == prof_id:
            checks['project_identity'] = 'OK'
        else:
            checks['project_identity'] = 'BLOCKED'
            reasons.append(f'conflict:project_identity (state:{ctx_project} != profile:{prof_id})')
    except Exception as e:
        checks['project_identity'] = 'BLOCKED'
        reasons.append(f'project_identity_error:{e}')

# 3. Frescura (informativo)
if checks['manifest'] != 'BLOCKED':
    try:
        state_path = expand(sources['state']['path'])
        mtime = datetime.datetime.fromtimestamp(os.path.getmtime(state_path))
        age_days = (datetime.datetime.now() - mtime).days
        if age_days > 7:
            checks['freshness'] = f'WARNING (state {age_days} dias)'
            warnings.append(f'stale:state ({age_days} dias)')
        else:
            checks['freshness'] = 'OK'
    except Exception as e:
        checks['freshness'] = 'UNKNOWN'

# 3b. Deriva (drift): compara reviewed_against_commit contra HEAD
head = get_head()
required_types = set(m.get('required', []))
optional_types = set(m.get('optional', []))
drift_required = []
drift_optional = []

# Extension 2026-10-08: cada fuente puede declarar repo_root propio.
# Si no lo declara, se usa REPO (comportamiento identico al historico).
_head_cache = {}

def _head_for_source(src):
    repo_root = src.get('repo_root')
    repo_path = expand(repo_root) if repo_root else REPO
    if repo_path not in _head_cache:
        _head_cache[repo_path] = get_head(repo_path)
    return _head_cache[repo_path], repo_path

if checks['manifest'] != 'BLOCKED':
    for src in m['sources']:
        if not src.get('authority'):
            continue
        if src.get('role') != 'singleton':
            continue
        stype = src.get('type')
        if stype not in required_types and stype not in optional_types:
            continue

        # Prioridad 1: reviewed_against_hash (D-2026-0010)
        reviewed_hash = src.get('reviewed_against_hash')
        if reviewed_hash is not None and reviewed_hash != '':
            current_hash = compute_source_hash(src.get('path', ''))
            if current_hash is None:
                state = 'INVALID'
                ref = f'path_no_hashable'
            elif current_hash == reviewed_hash:
                state = 'CURRENT'
                ref = reviewed_hash[:16]
            else:
                state = 'STALE'
                ref = f'{reviewed_hash[:8]}!={current_hash[:8]}'
            level = policy_for(state, stype in required_types)
            if level == 'BLOCKED':
                drift_required.append(f'{stype}({state}:{ref})')
            elif level == 'WARNING':
                drift_optional.append(f'{stype}({state}:{ref})')
            continue

        # Prioridad 2: reviewed_against_commit (legacy, D-2026-0009)
        reviewed = src.get('reviewed_against_commit')
        if reviewed is None or reviewed == '':
            # UNREVIEWED
            level = policy_for('UNREVIEWED', stype in required_types)
            if level == 'BLOCKED':
                drift_required.append(f'{stype}(UNREVIEWED:-)')
            elif level == 'WARNING':
                drift_optional.append(f'{stype}(UNREVIEWED:-)')
            continue

        src_head, src_repo = _head_for_source(src)
        if src_head is None:
            # Sin git en el repo de esa fuente: no se puede clasificar.
            # Si la fuente esta declarada con commit, asumimos que esta OK
            # porque su path probablemente no es git y no podemos comparar.
            continue

        state, _detail = classify_review(reviewed, src_head, src_repo)
        level = policy_for(state, stype in required_types)

        if level == 'BLOCKED':
            drift_required.append(f'{stype}({state}:{reviewed})')
        elif level == 'WARNING':
            drift_optional.append(f'{stype}({state}:{reviewed})')

    # Mostrar BLOCKED y WARNING simultaneamente si ambos existen.
    # Antes era elif, lo que ocultaba los WARNING cuando habia BLOCKED.
    parts = []
    if drift_required:
        parts.append(f'BLOCKED (required: {",".join(drift_required)})')
        reasons.append('drift_required:' + ','.join(drift_required))
    if drift_optional:
        parts.append(f'WARNING (optional: {",".join(drift_optional)})')
        warnings.append('drift_optional:' + ','.join(drift_optional))
    if parts:
        checks['drift'] = ' + '.join(parts)
    else:
        checks['drift'] = 'OK'
else:
    checks['drift'] = 'SKIP'

# 4. Status final
if any(v == 'BLOCKED' for v in checks.values()) or reasons:
    status = 'BLOCKED'
    exit_code = 2
elif warnings:
    status = 'WARNING'
    exit_code = 1
else:
    status = 'READY'
    exit_code = 0

# context_revision (opcional, informativo)
ctx_rev = None
try:
    hashes = []
    for t in ['state','profile','protocol','decisions']:
        with open(expand(sources[t]['path']), 'rb') as f:
            hashes.append(hashlib.sha256(f.read()).hexdigest())
    with open(MANIFEST, 'rb') as f:
        hashes.append(hashlib.sha256(f.read()).hexdigest())
    ctx_rev = f"{hashlib.sha256(''.join(hashes).encode()).hexdigest()[:8]} @ {datetime.date.today().isoformat()}"
except Exception:
    pass

result = {
    "status": status,
    "project": PROYECTO,
    "checks": checks,
    "reasons": reasons,
    "warnings": warnings,
    "context_revision": ctx_rev,
    "evaluated_at": datetime.datetime.now().astimezone().isoformat(timespec='seconds')
}

if JSON_OUT:
    print(json.dumps(result, indent=2, ensure_ascii=False))
else:
    print(f"=== LOGOS GATE — {PROYECTO} ===")
    labels = {
        'manifest': 'Manifest',
        'required': 'Required',
        'authority': 'Authority',
        'project_identity': 'Project identity',
        'freshness': 'Freshness',
        'drift': 'Drift'
    }
    for k, label in labels.items():
        v = checks.get(k, '-')
        print(f"{label:<18}{v}")
    print()
    print(f"STATUS: {status}")
    if reasons:
        for rsn in reasons:
            print(f"  Razon: {rsn}")
    if warnings:
        for w in warnings:
            print(f"  Aviso: {w}")

sys.exit(exit_code)
