#!/usr/bin/env python3
"""logos-ingesta - Ingesta y revision de archivos.

Uso:
  logos-ingesta pegar <archivo>     Lee stdin (Ctrl+D para terminar),
                                     agrega cabecera y guarda.
  logos-ingesta revisar <archivo>   Cuenta lineas, lista encabezados,
                                     detecta encabezados pegados.

Cabecera: comentario HTML con fecha y hora.
"""
import sys
import os
from datetime import datetime

CABECERA_TEMPLATE = "<!-- ingesta: {ts} -->\n"


def cmd_pegar(path):
    contenido = sys.stdin.read()
    if not contenido.strip():
        print("NADA: no pegaste contenido (o solo espacios).")
        return 1

    existe = os.path.exists(path)
    ts = datetime.now().strftime("%Y-%m-%d %H:%M")
    cabecera = CABECERA_TEMPLATE.format(ts=ts)

    modo = "a" if existe else "w"
    with open(path, modo, encoding="utf-8") as f:
        if existe:
            f.write("\n\n")
        f.write(cabecera)
        f.write(contenido)
        if not contenido.endswith("\n"):
            f.write("\n")

    with open(path, encoding="utf-8") as f:
        lineas = sum(1 for _ in f)

    if existe:
        print(f"OK: agregado a {path} ({lineas} lineas en total)")
    else:
        print(f"OK: creado {path} ({lineas} lineas)")
    return 0
def cmd_revisar(path):
    if not os.path.exists(path):
        print(f"NO EXISTE: {path}")
        return 1

    with open(path, encoding="utf-8") as f:
        lineas = f.readlines()

    n = len(lineas)
    print(f"Archivo: {path}")
    print(f"Lineas: {n}")
    print()

    # Encabezados
    print("Encabezados:")
    hay = False
    for i, ln in enumerate(lineas, 1):
        s = ln.rstrip("\n")
        if s.startswith("#"):
            print(f"  [{i}] {s[:70]}")
            hay = True
    if not hay:
        print("  (ninguno)")
    print()

    # Detectar encabezados pegados a parrafos (bug de hoy)
    print("Encabezados pegados a texto:")
    pegados = []
    for i, ln in enumerate(lineas, 1):
        # Bug real: linea NO empieza con # pero contiene "## "
        s = ln.rstrip("\n")
        if not s.startswith("#") and "## " in s:
            pegados.append((i, s[:90]))
    if pegados:
        for i, s in pegados:
            print(f"  [{i}] {s}")
        print()
        print(f"AVISO: {len(pegados)} encabezado(s) pegado(s). Usar")
        print("  sed o python para insertar un salto de linea antes.")
    else:
        print("  (ninguno)")
    print()

    # Aviso si el archivo esta vacio
    if n == 0:
        print("AVISO: el archivo esta vacio.")
        return 1

    print("OK: revision completa.")
    return 0


def cmd_listar(directorio=None):
    if directorio is None:
        directorio = os.path.expanduser("~/navego_recuperado/timonel/borradores")
    if not os.path.isdir(directorio):
        print("NO ES DIRECTORIO: " + directorio)
        return 1
    archivos = []
    for nombre in sorted(os.listdir(directorio)):
        if not nombre.endswith(".md"):
            continue
        full = os.path.join(directorio, nombre)
        if not os.path.isfile(full):
            continue
        stat = os.stat(full)
        with open(full, encoding="utf-8") as f:
            nlineas = sum(1 for _ in f)
        archivos.append((stat.st_mtime, stat.st_size, nlineas, nombre))
    if not archivos:
        print("Vacio: " + directorio)
        return 0
    archivos.sort(reverse=True)
    print("=== Borradores en " + directorio + " ===")
    print()
    print("  Fecha            Tamaño   Lineas  Archivo")
    print("  " + "-" * 62)
    total_lineas = 0
    for mtime, size, nlineas, nombre in archivos:
        fecha = datetime.fromtimestamp(mtime).strftime("%Y-%m-%d %H:%M")
        size_kb = size / 1024.0
        linea = "  " + fecha + "  " + str(round(size_kb, 1)).rjust(5) + "KB  " + str(nlineas).rjust(5) + "  " + nombre
        print(linea)
        total_lineas += nlineas
    print()
    print("Total: " + str(len(archivos)) + " archivos, " + str(total_lineas) + " lineas")
    return 0


def _repo_root():
    import subprocess
    here = os.path.dirname(os.path.abspath(__file__))
    try:
        out = subprocess.run(
            ["git", "-C", here, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True
        )
        return out.stdout.strip()
    except Exception:
        return None


def cmd_commit(archivo, mensaje, push=False):
    import subprocess
    if mensaje is None or not mensaje.strip():
        print("Falta el mensaje de commit.")
        print('Uso: logos-ingesta commit <archivo> "mensaje"')
        return 1
    if not os.path.exists(archivo):
        print("NO EXISTE: " + archivo)
        return 1
    root = _repo_root()
    if root is None:
        print("No pude encontrar el repo git.")
        return 1
    abs_archivo = os.path.abspath(archivo)
    untracked = subprocess.run(
        ["git", "-C", root, "ls-files", "--others", "--exclude-standard", "--", abs_archivo],
        capture_output=True, text=True
    ).stdout.strip()
    diff = subprocess.run(["git", "-C", root, "diff", "--quiet", "--", abs_archivo], capture_output=True)
    diff_staged = subprocess.run(["git", "-C", root, "diff", "--cached", "--quiet", "--", abs_archivo], capture_output=True)
    sin_cambios = (diff.returncode == 0 and diff_staged.returncode == 0)
    if sin_cambios and not untracked:
        print("Sin cambios: " + os.path.relpath(abs_archivo, root))
        return 0
    add = subprocess.run(["git", "-C", root, "add", abs_archivo], capture_output=True, text=True)
    if add.returncode != 0:
        print("ERROR en git add:")
        print(add.stderr)
        return 1
    commit = subprocess.run(["git", "-C", root, "commit", "-m", mensaje], capture_output=True, text=True)
    if commit.returncode != 0:
        print("ERROR en git commit:")
        print(commit.stderr)
        return 1
    hash_out = subprocess.run(["git", "-C", root, "log", "--oneline", "-1"], capture_output=True, text=True).stdout.strip()
    print("OK: " + hash_out)
    if push:
        push_out = subprocess.run(["git", "-C", root, "push", "origin", "HEAD"], capture_output=True, text=True)
        if push_out.returncode != 0:
            print("AVISO: el commit quedo local. Push fallo:")
            print(push_out.stderr)
            return 1
        print("OK: pusheado")
    else:
        print("(recorda hacer push si queres subirlo)")
    return 0


def cmd_mover(origen, destino):
    import subprocess
    if not os.path.exists(origen):
        print("NO EXISTE origen: " + origen)
        return 1
    if not os.path.exists(destino):
        print("NO EXISTE destino: " + destino)
        return 1
    if not os.path.isdir(destino):
        print("Destino no es directorio: " + destino)
        return 1

    nombre = os.path.basename(origen)
    destino_final = os.path.join(destino, nombre)
    if os.path.exists(destino_final):
        print("AVISO: ya existe " + destino_final)
        print("No muevo nada.")
        return 1

    root = _repo_root()
    if root is None:
        print("No pude encontrar el repo git.")
        return 1

    abs_origen = os.path.abspath(origen)
    # Ver si esta trackeado
    ls = subprocess.run(
        ["git", "-C", root, "ls-files", "--", abs_origen],
        capture_output=True, text=True
    ).stdout.strip()

    if ls:
        cmd = ["git", "-C", root, "mv", abs_origen, os.path.abspath(destino_final)]
    else:
        cmd = ["mv", abs_origen, os.path.abspath(destino_final)]

    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        print("ERROR al mover:")
        print(r.stderr)
        return 1

    print("OK: " + origen + " -> " + destino_final)
    print("(recorda commitear el cambio)")
    return 0


def cmd_estado():
    import subprocess
    root = _repo_root()
    if root is None:
        print("No pude encontrar el repo git.")
        return 1

    print("=== Estado del repo ===")
    print("Repo: " + root)
    print()

    # HEAD vs origin
    head = subprocess.run(
        ["git", "-C", root, "rev-parse", "--short", "HEAD"],
        capture_output=True, text=True
    ).stdout.strip()
    print("HEAD: " + head)

    adelante = subprocess.run(
        ["git", "-C", root, "rev-list", "--count", "@{upstream}..HEAD"],
        capture_output=True, text=True
    ).stdout.strip()
    if adelante == "" or "fatal" in adelante.lower():
        adelante = "0"
    if adelante and adelante != "0":
        print("AVISO: " + adelante + " commit(s) locales sin pushear")
    else:
        print("Sincronizado con origin")
    print()

    # Archivos modificados
    status = subprocess.run(
        ["git", "-C", root, "status", "--porcelain", "-uall"],
        capture_output=True, text=True
    ).stdout

    if not status.strip():
        print("Working tree limpio.")
        return 0

    lineas = status.strip().split("\n")
    exp = [l for l in lineas if "EXPEDIENTE/" in l]
    borr = [l for l in lineas if "borradores/" in l]
    otros = [l for l in lineas if l not in exp and l not in borr]

    print("Cambios sin commitear: " + str(len(lineas)) + " archivo(s)")
    print()
    if exp:
        print("EXPEDIENTE/ (" + str(len(exp)) + "):")
        for l in exp[:10]:
            print("  " + l)
        if len(exp) > 10:
            print("  ... y " + str(len(exp) - 10) + " mas")
        print()
    if borr:
        print("borradores/ (" + str(len(borr)) + "):")
        for l in borr[:10]:
            print("  " + l)
        if len(borr) > 10:
            print("  ... y " + str(len(borr) - 10) + " mas")
        print()
    if otros:
        print("otros (" + str(len(otros)) + "):")
        for l in otros[:10]:
            print("  " + l)
        if len(otros) > 10:
            print("  ... y " + str(len(otros) - 10) + " mas")
        print()

    return 0


def main():
    args = sys.argv[1:]
    if not args:
        print("Uso:")
        print("  logos-ingesta pegar <archivo>")
        print("  logos-ingesta revisar <archivo>")
        print("  logos-ingesta listar [directorio]")
        print('  logos-ingesta commit [--push] <archivo> "mensaje"')
        print("  logos-ingesta mover <origen> <destino>")
        print("  logos-ingesta estado")
        return 1

    modo = args[0]
    resto = args[1:]

    if modo == "pegar":
        if not resto:
            print("Falta <archivo>")
            return 1
        return cmd_pegar(resto[0])
    elif modo == "revisar":
        if not resto:
            print("Falta <archivo>")
            return 1
        return cmd_revisar(resto[0])
    elif modo == "listar":
        return cmd_listar(resto[0] if resto else None)
    elif modo == "mover":
        if len(resto) < 2:
            print("Falta <origen> y/o <destino>")
            return 1
        return cmd_mover(resto[0], resto[1])
    elif modo == "estado":
        return cmd_estado()
    elif modo == "commit":
        push = "--push" in resto
        limpio = [a for a in resto if a != "--push"]
        if not limpio:
            print("Falta <archivo>")
            return 1
        arch = limpio[0]
        mensaje = limpio[1] if len(limpio) > 1 else None
        return cmd_commit(arch, mensaje, push=push)
    else:
        print("Modo desconocido: " + modo)
        return 1


if __name__ == "__main__":
    sys.exit(main())
