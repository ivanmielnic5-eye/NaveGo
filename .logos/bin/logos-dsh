#!/usr/bin/env python3
"""Wrapper de arranque para DSH.
Uso: logos-dsh PROYECTO "tarea" [--force-warning] [--dry-run]"""
import json, os, sys, subprocess, datetime

REPO = os.getcwd()
GATE = os.path.join(REPO, '.logos/bin/logos-gate')
MEM = os.path.join(REPO, '.logos/bin/logos-mem')
CAPSULA_MD = os.path.join(REPO, 'capsula-de-memoria.md')
DSH = 'dsh'

args = [a for a in sys.argv[1:] if not a.startswith('--')]
flags = [a for a in sys.argv[1:] if a.startswith('--')]
FORCE_WARNING = '--force-warning' in flags
DRY_RUN = '--dry-run' in flags
FRONTERA = None
for f in flags:
    if f.startswith('--frontera='):
        FRONTERA = f.split('=', 1)[1]
if FRONTERA is None:
    # Default: el sandbox del proyecto
    FRONTERA = 'sandbox_corredor/'
# Normalizar: rutas relativas al REPO
if not FRONTERA.startswith('/'):
    FRONTERA_ABS = os.path.join(REPO, FRONTERA)
else:
    FRONTERA_ABS = FRONTERA

if len(args) < 2:
    print("ERROR: uso: logos-dsh PROYECTO \"tarea\" [--force-warning] [--dry-run]")
    sys.exit(5)
PROYECTO = args[0]
TAREA = ' '.join(args[1:])

print(f"=== logos-dsh v1.1.0 — {PROYECTO} ===")
print()

# Paso 0: Gate
print("--- Paso 0: Context Gate ---")
r = subprocess.run([GATE, PROYECTO, '--json'], capture_output=True, text=True)
try:
    gate_result = json.loads(r.stdout)
except Exception:
    print(f"ERROR: no pude parsear salida del Gate.")
    print(r.stdout)
    sys.exit(5)

status = gate_result.get('status')
ctx_rev = gate_result.get('context_revision', '?')
print(f"Gate status: {status}")
print(f"context_revision: {ctx_rev}")

if status == 'BLOCKED':
    print()
    print("ABORT: Gate BLOCKED. DSH no se ejecuta.")
    for rsn in gate_result.get('reasons', []):
        print(f"  Razon: {rsn}")
    sys.exit(2)

if status == 'WARNING' and not FORCE_WARNING:
    print()
    print("ABORT: Gate WARNING. Falta --force-warning para continuar.")
    for w in gate_result.get('warnings', []):
        print(f"  Aviso: {w}")
    sys.exit(3)

if status == 'WARNING' and FORCE_WARNING:
    print("AVISO: WARNING forzado por --force-warning.")

print()

# Paso 1: Cápsula
print("--- Paso 1: Cápsula de Memoria ---")
r = subprocess.run([MEM, PROYECTO], capture_output=True, text=True)
if r.returncode != 0:
    print("ABORT: logos-mem falló.")
    print(r.stdout)
    print(r.stderr)
    sys.exit(4)
print(f"OK. Cápsula en: {CAPSULA_MD}")

# Leer cápsula
try:
    with open(CAPSULA_MD) as f:
        capsula = f.read()
except Exception as e:
    print(f"ABORT: no pude leer la cápsula: {e}")
    sys.exit(4)

# Paso 2: Construir prompt
prompt = (
    "[CONTEXTO - Capsula de Memoria]\n"
    + capsula
    + "\n\n[TAREA]\n"
    + TAREA
    + "\n\n[REGLA]\n"
    + "Trabaja respetando el contexto anterior. Si algo no esta en el "
    + "contexto, declaralo como incertidumbre en lugar de inventarlo.\n"
    + "\n[RESTRICCIONES OPERATIVAS]\n"
    + "- NO ejecutes 'git commit'. El commit lo hace el humano tras revision.\n"
    + "- NO modifiques archivos en .logos/ (gobernanza del sistema).\n"
    + "- NO modifiques AGENTS.md ni START_HERE.md.\n"
    + "- NO modifiques tests para ocultar fallos.\n"
    + "- Ante conflicto entre spec/test/codigo: DETENETE y reporta.\n"
    + "- Ante incertidumbre arquitectonica: DETENETE y reporta."
)

print()
print(f"--- Prompt construido ({len(prompt)} chars) ---")

if DRY_RUN:
    print()
    print("DRY-RUN: no se llama a DSH. Prompt listo.")
    print(f"context_revision: {ctx_rev}")
    sys.exit(0)

# Control-plane integrity: snapshot antes de DSH
GOBERNANZA_PATHS = [
    '.logos/MANIFEST.json',
    'AGENTS.md',
    'START_HERE.md',
    '.logos/core/protocol/protocols.json',
]
def hash_gobernanza():
    import hashlib
    hashes = {}
    for p in GOBERNANZA_PATHS:
        full = os.path.join(REPO, p) if not p.startswith('/') else p
        if not p.startswith('.logos/core'):
            full = os.path.join(REPO, p)
        else:
            full = os.path.expanduser('~/' + p)
        if os.path.exists(full):
            with open(full, 'rb') as f:
                hashes[p] = hashlib.sha256(f.read()).hexdigest()[:12]
        else:
            hashes[p] = '(ausente)'
    return hashes

# Snapshot de commits antes
try:
    head_antes = subprocess.run(['git','rev-parse','HEAD'],
                                 capture_output=True, text=True, cwd=REPO).stdout.strip()
except Exception:
    head_antes = None

# Snapshot de hashes de gobernanza antes
gober_antes = hash_gobernanza()

# Snapshot ampliado: archivos del repo fuera de la frontera autorizada
# (para detectar escrituras de DSH fuera del sandbox)
def snapshot_fuera_de_frontera():
    """Lista archivos del repo NO dentro de la frontera autorizada,
    con su mtime+size. Solo versionados/untracked relevantes."""
    result = {}
    for root, dirs, files in os.walk(REPO):
        # Saltar dirs pesados o irrelevantes
        dirs[:] = [d for d in dirs if d not in (
            'node_modules', '.git', 'backups', '_backups',
            'android', 'ios', 'test_maplibre', 'test_parse',
            'assets', 'out_mision_b'
        )]
        # Saltar si estamos dentro de la frontera autorizada
        if os.path.abspath(root).startswith(os.path.abspath(FRONTERA_ABS)):
            continue
        for fn in files:
            # Saltar extensiones enormes
            if fn.endswith(('.apk', '.aab', '.pbf', '.mbtiles', '.geojson')):
                continue
            full = os.path.join(root, fn)
            try:
                st = os.stat(full)
                rel = os.path.relpath(full, REPO)
                result[rel] = (int(st.st_mtime), st.st_size)
            except Exception:
                pass
    return result

snap_repo_antes = snapshot_fuera_de_frontera()
print(f"--- Snapshot: {len(snap_repo_antes)} archivos fuera de la frontera ---")

# Paso 3: Ejecutar DSH
print()
print("--- Paso 3: Ejecutando DSH (headless) ---")
r = subprocess.run([DSH, '--profile', 'headless', prompt],
                   capture_output=True, text=True)
print("--- Salida de DSH ---")
if r.stdout:
    print(r.stdout)
if r.stderr:
    print("[stderr]")
    print(r.stderr)
print("--- Fin de salida DSH ---")

# Control-plane integrity: verificar despues de DSH
gober_despues = hash_gobernanza()
cambios_gober = [k for k in gober_antes if gober_antes[k] != gober_despues[k]]
if cambios_gober:
    print()
    print("!!! ALERTA: DSH modifico archivos de gobernanza (no autorizado).")
    for k in cambios_gober:
        print(f"    {k}: {gober_antes[k]} -> {gober_despues[k]}")
    print("    Esto viola control-plane integrity. Revisar antes de aceptar cambios.")

# Verificar commits nuevos
try:
    head_despues = subprocess.run(['git','rev-parse','HEAD'],
                                   capture_output=True, text=True, cwd=REPO).stdout.strip()
except Exception:
    head_despues = None
if head_antes != head_despues:
    print()
    print("!!! ALERTA: DSH creo commits (no autorizado).")
    print(f"    ANTES: {head_antes}")
    print(f"    AHORA: {head_despues}")
    print("    El wrapper NO autoriza commits. Revisar y revertir si es necesario.")

# Verificacion ampliada: archivos fuera de la frontera autorizada
snap_repo_despues = snapshot_fuera_de_frontera()
creados = [k for k in snap_repo_despues if k not in snap_repo_antes]
borrados = [k for k in snap_repo_antes if k not in snap_repo_despues]
modificados = [k for k in snap_repo_despues
               if k in snap_repo_antes and snap_repo_despues[k] != snap_repo_antes[k]]

if creados or borrados or modificados:
    print()
    print("!!! ALERTA: hubo cambios fuera de la frontera autorizada.")
    print(f"    Frontera: {FRONTERA}")
    if creados:
        print(f"    Archivos CREADOS fuera de frontera ({len(creados)}):")
        for k in creados[:10]:
            print(f"      + {k}")
        if len(creados) > 10:
            print(f"      ... y {len(creados)-10} mas")
    if modificados:
        print(f"    Archivos MODIFICADOS fuera de frontera ({len(modificados)}):")
        for k in modificados[:10]:
            print(f"      ~ {k}")
        if len(modificados) > 10:
            print(f"      ... y {len(modificados)-10} mas")
    if borrados:
        print(f"    Archivos BORRADOS fuera de frontera ({len(borrados)}):")
        for k in borrados[:10]:
            print(f"      - {k}")
        if len(borrados) > 10:
            print(f"      ... y {len(borrados)-10} mas")
    print()
    print("    Para revisar cambios:  cd REPO && git status")
    print("    Para revertir versionados: git checkout -- <archivo>")
    print("    Para eliminar untracked creados: rm <archivo>")
    print("    NO se revierte automaticamente. Decision humana.")

# Paso 4: Reportar
print()
print("--- Paso 4: Reporte ---")
print(f"Gate status:     {status}")
print(f"context_revision: {ctx_rev}")
print(f"DSH exit code:   {r.returncode}")

# Chequear si hay cambios sin commitear
gs = subprocess.run(['git', 'status', '--short'], capture_output=True, text=True)
if gs.stdout.strip():
    print()
    print("Hay cambios sin commitear en el repo:")
    print(gs.stdout)
    print("Revisar antes de aceptar.")
else:
    print("Repo limpio (sin cambios).")

sys.exit(r.returncode)
